# DeployX web app (control plane) — copy to apps/web/.env.local and fill in.
#   cp apps/web/.env.example apps/web/.env.local
#
# You only need this to run or host the web app yourself. To run pipelines on
# your machine against the hosted app, you need no env file at all — see
# README → "Running a runner".
#
# Never commit .env.local. Paste values without quotes or trailing spaces/newlines
# (a trailing newline in the Supabase URL breaks live updates in the browser).

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API (or `npx supabase status` locally)

# Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" public key. Safe in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET: bypasses Row Level Security. Server-side only
# (runner API, cron tick, webhooks). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── DeployX ─────────────────────────────────────────────────────────────────

# SECRET: encrypts project secrets, GitHub tokens and webhook secrets
# (AES-256-GCM; the value is hashed to a 32-byte key, so any long random
# string works). Generate with:  openssl rand -hex 32
# Changing it later makes everything already encrypted unreadable.
DEPLOYX_SECRET_KEY=

# SECRET: bearer token for /api/cron/* (the once-a-minute platform tick).
# Generate with:  openssl rand -hex 32
# Store the same value in Supabase Vault as 'deployx_cron_secret' (see README).
CRON_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Time zone used to display dates (server and browser render the same text).
# Any IANA zone name. Defaults to Asia/Kolkata.
# NEXT_PUBLIC_DISPLAY_TIME_ZONE=Asia/Kolkata
